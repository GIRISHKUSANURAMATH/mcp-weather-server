# Optional settings for the weather MCP server. All have sensible defaults;
# the server works with none of these set.
#
# NOTE: the server reads real environment variables; it does not load a .env file.
# Set them in your shell, in your MCP client's server config ("env" block), or in
# extension/manifest.json → server.mcp_config.env before running `npm run pack:mcpb`.
# See README → "Configuration (optional)".

# Identify yourself to the National Weather Service. NWS asks clients to send a
# User-Agent that lets them contact you if your traffic causes problems.
# Example: my-weather-app/1.0 (you@example.com)
NWS_USER_AGENT=mcp-weather-server/1.0.0 (local MCP server)

# Base URL of the NWS API (change only for testing against a mock server).
NWS_API_BASE=https://api.weather.gov

# Per-request timeout in milliseconds (1000–120000).
NWS_TIMEOUT_MS=15000

# Retries after a network error, timeout or 5xx response (0–5).
NWS_MAX_RETRIES=1

# Log verbosity on stderr: debug | info | warn | error | silent
LOG_LEVEL=info
