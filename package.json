{
  "name": "mcp-weather-server",
  "version": "1.0.0",
  "description": "MCP server exposing US National Weather Service alerts and forecasts (get_alerts, get_forecast) to Claude Desktop over stdio.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-weather-server": "dist/index.js"
  },
  "files": [
    "dist",
    "extension/manifest.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node dist/smoke-test.js",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "verify": "npm run typecheck && npm test && npm run build",
    "configure:claude": "node scripts/configure-claude-desktop.mjs",
    "pack:mcpb": "node scripts/pack-mcpb.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "weather",
    "nws",
    "claude"
  ],
  "license": "MIT",
  "author": "Girish Kusanuramath",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "vitest": "5.1.0"
  }
}
